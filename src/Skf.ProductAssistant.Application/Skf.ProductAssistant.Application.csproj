<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Skf.ProductAssistant.Application</RootNamespace>
    <AssemblyName>Skf.ProductAssistant.Application</AssemblyName>
  </PropertyGroup>

  <!--
    Application layer contains all business logic:
    - Orchestration: Routes requests to appropriate agents
    - Agents: SK-powered agents for Q&A and Feedback
    - Plugins: SK function calling for data access
    - Services: Intent classification, normalization, state management
    - Guards: Hallucination prevention
    - DTOs: Request/Response models

    This layer references:
    - Domain: For entities, value objects, and repository interfaces
    - Infrastructure: For SK configuration and normalization utilities
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.25.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Skf.ProductAssistant.Domain\Skf.ProductAssistant.Domain.csproj" />
    <ProjectReference Include="..\Skf.ProductAssistant.Infrastructure\Skf.ProductAssistant.Infrastructure.csproj" />
  </ItemGroup>

</Project>
